generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./banco_euroespid.db"
}

// Tabela de Notas Fiscais
model NotaFiscal {
  chave          String    @id
  numero         String
  destinatario   String
  transportadora String
  status         String    @default("AGUARDANDO")
  criadoEm       DateTime  @default(now())
  produtos       Produto[] 
}

// Tabela de Produtos (Relacionada à Nota Fiscal)
model Produto {
  id           String     @id @default(uuid())
  codigo       String
  descricao    String
  qtdEsperada  Int
  qtdConferida Int        @default(0)
  lote         String?
  
  // Relacionamento com a Nota Fiscal
  notaChave    String
  nota         NotaFiscal @relation(fields: [notaChave], references: [chave])
}